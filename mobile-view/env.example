# Copy to mobile-view/.env — restart Expo after changes (npx expo start -c)
#
# Default (no .env): production API — same as web (navbar-landing/lib/api.ts)
#   https://crm-backend-production-fc85.up.railway.app/api
#
# Optional: force a specific API URL (production or staging)
# EXPO_PUBLIC_API_URL=https://crm-backend-production-fc85.up.railway.app/api
#
# Local backend on your laptop (port 5001):
# EXPO_PUBLIC_USE_PRODUCTION=false
# EXPO_PUBLIC_API_URL=http://YOUR_LAPTOP_IP:5001/api
